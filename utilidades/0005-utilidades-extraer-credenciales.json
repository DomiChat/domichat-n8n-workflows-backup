  "name": "0005 Utilidades Extraer credenciales",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const input = $input.all()[0].json;\nconst jsonString = input.stdout.match(/\\[{.*}\\]/s);\n\nif (!jsonString) {\n  return [{ json: { error: \"No se encontraron credenciales\" } }];\n}\n\ntry {\n  const credentials = JSON.parse(jsonString[0]);\n  return credentials.map(cred => ({ json: cred }));\n} catch (error) {\n  return [{ json: { error: `Error parseando credenciales: ${error.message}` } }];\n}"
      },
