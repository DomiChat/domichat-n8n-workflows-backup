    {
      "parameters": {
        "jsCode": "// Procesar todas las ejecuciones y extraer mensajes de WhatsApp\nconst executionsData = $input.all();\nconst messages = [];\nconst userRegistry = {};\n\n// Función para obtener propiedades anidadas\nfunction getNestedProperty(obj, path) {\n  if (!path) return obj;\n  return path.split('.').reduce((current, part) => current?.[part], obj);\n}\n\n// Función para resolver variables de n8n en un template\nfunction resolveN8nVariables(template, nodeName, runData, itemIndex = 0) {\n  if (!template || typeof template !== 'string') return template;\n  \n  return template.replace(/\\{\\{\\s*([^}]+)\\s*\\}\\}/g, (fullMatch, expression) => {\n    expression = expression.trim();\n    let value = null;\n    \n    // 1. $json.campo → nodo anterior\n    if (expression.startsWith('$json')) {\n      const path = expression.replace('$json', '').replace(/^\\./, '');\n      const previousNode = runData[nodeName]?.[0]?.source?.[0]?.previousNode;\n      \n      if (previousNode) {\n        const nodeData = runData[previousNode]?.[0]?.data?.main?.[0];\n        if (nodeData?.[itemIndex]) {\n          value = getNestedProperty(nodeData[itemIndex].json, path);\n        }\n      }\n    }\n    // 2. $('NodoX').method().json.campo\n    else if (expression.includes('$(')) {\n      const nodeRefMatch = expression.match(/\\$\\(['\"]([^'\"]+)['\"]\\)/);\n      if (nodeRefMatch) {\n        const refNodeName = nodeRefMatch[1];\n        const restExpression = expression.substring(nodeRefMatch[0].length);\n        const nodeData = runData[refNodeName]?.[0]?.data?.main?.[0];\n        \n        if (nodeData) {\n          let targetJson = null;\n          let path = '';\n          \n          if (restExpression.includes('.first()')) {\n            targetJson = nodeData[0]?.json;\n            path = restExpression.replace('.first()', '').replace(/^\\.json\\.?/, '');\n          } else if (restExpression.includes('.last()')) {\n            targetJson = nodeData[nodeData.length - 1]?.json;\n            path = restExpression.replace('.last()', '').replace(/^\\.json\\.?/, '');\n          } else if (restExpression.includes('.item.json')) {\n            targetJson = nodeData[itemIndex]?.json;\n            path = restExpression.replace('.item.json', '').replace(/^\\./, '');\n          } else {\n            targetJson = nodeData[0]?.json;\n            path = restExpression.replace(/^\\.json\\.?/, '');\n          }\n          \n          if (targetJson) {\n            value = getNestedProperty(targetJson, path);\n          }\n        }\n      }\n    }\n    \n    return value !== null && value !== undefined ? value : '[N/A]';\n  });\n}\n\n// Función para extraer mensaje de parámetros HTTP\nfunction extractMessageFromParams(params) {\n  // 1. bodyParameters.parameters\n  if (params.bodyParameters?.parameters) {\n    const textParam = params.bodyParameters.parameters.find(p => p.name === 'text');\n    if (textParam?.value) {\n      if (typeof textParam.value === 'string') {\n        const bodyMatch = textParam.value.match(/body:\\s*['\"](.+?)['\"]\\s*}/s);\n        if (bodyMatch) {\n          return bodyMatch[1].replace(/\\\\n/g, '\\n').replace(/\\\\'/g, \"'\").replace(/\\\\\"/g, '\"');\n        }\n        return textParam.value;\n      }\n      if (textParam.value?.body) return textParam.value.body;\n    }\n  }\n  \n  // 2. jsonBody\n  if (params.jsonBody && typeof params.jsonBody === 'string') {\n    const textMatch = params.jsonBody.match(/\"body\"\\s*:\\s*\"([^\"]+)\"/);\n    if (textMatch) {\n      return textMatch[1].replace(/\\\\n/g, '\\n').replace(/\\\\\"/g, '\"');\n    }\n  }\n  \n  return null;\n}\n\nfor (const execution of executionsData) {\n  try {\n    const executionData = execution.json.data;\n    const workflowData = execution.json.workflowData;\n    const runData = executionData?.resultData?.runData;\n    \n    if (!runData) continue;\n    \n    // Buscar nodos clave\n    const triggerNode = Object.keys(runData).find(key => \n      key.toLowerCase().includes('whatsapp') && key.toLowerCase().includes('trigger')\n    );\n    const validarNode = Object.keys(runData).find(key => \n      key.toLowerCase().includes('validar') && key.toLowerCase().includes('usuario')\n    );\n    const detectarNode = Object.keys(runData).find(key => \n      key.toLowerCase().includes('detectar') && key.toLowerCase().includes('confirmación')\n    );\n    \n    let contactInfo = null;\n    \n    // Procesar usuario registrado\n    if (validarNode && runData[validarNode]) {\n      const validarData = runData[validarNode][0]?.data?.main?.[0]?.[0]?.json;\n      if (validarData?.id && validarData?.nombre && validarData?.numero_telefono) {\n        const registeredUser = {\n          wa_id: validarData.numero_telefono,\n          nombre: `${validarData.nombre.trim()} ${validarData.apellido?.trim() || ''}`.trim(),\n          isRegistered: true\n        };\n        userRegistry[validarData.numero_telefono] = registeredUser;\n      }\n    }\n    \n    // Procesar mensajes entrantes\n    if (triggerNode && runData[triggerNode]) {\n      const triggerData = runData[triggerNode][0]?.data?.main?.[0];\n      \n      if (triggerData) {\n        for (const item of triggerData) {\n          const data = item.json;\n          \n          if (data.messaging_product !== 'whatsapp' || !data.contacts || !data.messages?.[0]) continue;\n          \n          const contact = data.contacts[0];\n          const message = data.messages[0];\n          \n          // Determinar nombre del usuario\n          const registeredUser = userRegistry[contact.wa_id];\n          const userName = registeredUser \n            ? registeredUser.nombre \n            : (contact.profile?.name ? `${contact.profile.name} (No registrado)` : 'No registrado');\n          const isRegistered = !!registeredUser;\n          \n          if (!contactInfo) {\n            contactInfo = {\n              wa_id: contact.wa_id,\n              phone: message.from,\n              name: userName,\n              isRegistered: isRegistered\n            };\n          }\n          \n          let messageBody = null;\n          let messageType = 'text';\n          let audioBinary = null;\n          \n          // Mensaje de texto\n          if (message.type === 'text' && message.text?.body) {\n            messageBody = message.text.body;\n          }\n          // Mensaje de audio\n          else if (message.type === 'audio' && message.audio) {\n            messageBody = '🎤 Audio';\n            messageType = 'audio';\n            \n            const descargarNode = Object.keys(runData).find(key => \n              key.toLowerCase().includes('descargar') && key.toLowerCase().includes('audio')\n            );\n            \n            if (descargarNode && runData[descargarNode]) {\n              const audioItems = runData[descargarNode][0]?.data?.main?.[0];\n              const audioItem = audioItems?.find(item => item.binary?.data);\n              if (audioItem) {\n                audioBinary = {\n                  mimeType: 'audio/ogg; codecs=opus',\n                  data: audioItem.binary.data.data\n                };\n              }\n            }\n          }\n          \n          if (messageBody) {\n            messages.push({\n              from: message.from,\n              wa_id: contact.wa_id,\n              name: userName,\n              body: messageBody,\n              timestamp: parseInt(message.timestamp) * 1000,\n              executionDate: execution.json.startedAt,\n              executionId: execution.json.id,\n              type: 'incoming',\n              messageType: messageType,\n              audioBinary: audioBinary,\n              isRegistered: isRegistered,\n              executionIndex: runData[triggerNode][0].executionIndex || 0\n            });\n          }\n        }\n      }\n    }\n    \n    // Procesar mensajes salientes\n    if (contactInfo && workflowData?.nodes) {\n      // 1. Nodo \"Detectar Confirmación\"\n      if (detectarNode && runData[detectarNode]) {\n        const detectarData = runData[detectarNode][0]?.data?.main?.[0];\n        const executionIndex = runData[detectarNode][0].executionIndex || 0;\n        \n        if (detectarData) {\n          for (const item of detectarData) {\n            const output = item.json?.output;\n            if (output && typeof output === 'string' && output.trim()) {\n              messages.push({\n                from: 'bot',\n                wa_id: contactInfo.wa_id,\n                name: 'DomiChat',\n                body: output,\n                timestamp: new Date(execution.json.startedAt).getTime() + executionIndex * 100,\n                executionDate: execution.json.startedAt,\n                executionId: execution.json.id,\n                type: 'outgoing',\n                messageType: 'text',\n                executionIndex: executionIndex\n              });\n            }\n          }\n        }\n      }\n      \n      // 2. Nodos HTTP Request\n      for (const nodeName of Object.keys(runData)) {\n        if (nodeName === triggerNode || nodeName === detectarNode || nodeName === 'Enviar Respuesta') continue;\n        \n        const nodeExecutions = runData[nodeName];\n        if (!nodeExecutions?.length) continue;\n        \n        const nodeDefinition = workflowData.nodes.find(n => n.name === nodeName);\n        if (nodeDefinition?.type !== 'n8n-nodes-base.httpRequest') continue;\n        \n        const params = nodeDefinition.parameters;\n        const isWhatsAppCall = params.url?.includes('graph.facebook.com') && \n                               params.url?.includes('/messages') && \n                               params.method === 'POST';\n        \n        if (!isWhatsAppCall) continue;\n        \n        for (const nodeExecution of nodeExecutions) {\n          if (nodeExecution.executionStatus !== 'success') continue;\n          \n          const messageTemplate = extractMessageFromParams(params);\n          if (!messageTemplate) continue;\n          \n          const resolvedMessage = resolveN8nVariables(messageTemplate, nodeName, runData, 0);\n          if (!resolvedMessage?.trim()) continue;\n          \n          const executionIndex = nodeExecution.executionIndex || 0;\n          \n          messages.push({\n            from: 'bot',\n            wa_id: contactInfo.wa_id,\n            name: 'DomiChat',\n            body: resolvedMessage,\n            timestamp: new Date(execution.json.startedAt).getTime() + executionIndex * 100,\n            executionDate: execution.json.startedAt,\n            executionId: execution.json.id,\n            type: 'outgoing',\n            messageType: 'text',\n            nodeSource: nodeName,\n            executionIndex: executionIndex\n          });\n        }\n      }\n    }\n    \n  } catch (error) {\n    console.log('Error procesando ejecución:', execution.json?.id, error.message);\n  }\n}\n\n// Ordenar por fecha de ejecución y luego por índice de ejecución\nmessages.sort((a, b) => {\n  const dateCompare = new Date(a.executionDate).getTime() - new Date(b.executionDate).getTime();\n  return dateCompare !== 0 ? dateCompare : a.executionIndex - b.executionIndex;\n});\n\n// Agrupar por conversación\nconst conversations = {};\n\nfor (const msg of messages) {\n  if (!conversations[msg.wa_id]) {\n    conversations[msg.wa_id] = {\n      wa_id: msg.wa_id,\n      phone: msg.from !== 'bot' ? msg.from : msg.wa_id,\n      name: msg.type === 'incoming' ? msg.name : 'Usuario',\n      messages: [],\n      lastMessageDate: msg.timestamp,\n      messageCount: 0,\n      isRegistered: msg.isRegistered || false\n    };\n  }\n  \n  const conv = conversations[msg.wa_id];\n  \n  // Actualizar nombre con mejor información\n  if (msg.type === 'incoming') {\n    if (msg.isRegistered && !conv.isRegistered) {\n      conv.name = msg.name;\n      conv.isRegistered = true;\n    } else if (!conv.isRegistered) {\n      conv.name = msg.name;\n    }\n  }\n  \n  conv.messages.push(msg);\n  conv.messageCount++;\n  conv.lastMessageDate = Math.max(conv.lastMessageDate, msg.timestamp);\n}\n\nconst conversationsList = Object.values(conversations).sort((a, b) => \n  b.lastMessageDate - a.lastMessageDate\n);\n\nreturn [{\n  json: {\n    totalMessages: messages.length,\n    totalConversations: conversationsList.length,\n    conversations: conversationsList\n  }\n}];"
      },
      "id": "4325b83f-70c2-4ae5-abd7-e6b06a6c158c",
