      "parameters": {
        "jsCode": "const items = $input.all();\nconst lastItem = items[items.length - 1].json;\n\nreturn {\n  json: {\n    estado: 'Timer Extendido Completado',\n    iteracionesRealizadas: lastItem.total,\n    tiempoTotalSegundos: lastItem.tiempoTotal,\n    tiempoTotalMinutos: Math.round(lastItem.tiempoTotal / 60 * 100) / 100,\n    completadoEn: new Date().toISOString()\n  }\n};"
