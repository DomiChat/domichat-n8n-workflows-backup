      "parameters": {
        "jsCode": "const iteracion = $input.first().json.iteracion;\nconst total = $input.first().json.total;\nconst timerSeconds = $input.first().json.timerSeconds;\n\nreturn {\n  json: {\n    mensaje: `Timer completado: ${iteracion}/${total} iteraciones`,\n    tiempoTranscurrido: iteracion * timerSeconds,\n    tiempoTotal: total * timerSeconds,\n    progreso: `${Math.round((iteracion/total) * 100)}%`,\n    iteracion: iteracion,\n    total: total\n  }\n};"
      },
