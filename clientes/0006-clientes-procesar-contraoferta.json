      "parameters": {
        "jsCode": "const multiplicador = $input.first().json.multiplicador;\nconst timerSeconds = $input.first().json.timerSeconds;\n\nconst items = [];\nfor (let i = 0; i < multiplicador; i++) {\n  items.push({\n    json: {\n      iteracion: i + 1,\n      total: multiplicador,\n      timerSeconds: timerSeconds\n    }\n  });\n}\n\nreturn items;"
